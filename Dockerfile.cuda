# NVIDIA GPU image: same app, brain simulated on the GPU (FLYSIM_BACKEND=cuda).
# Needs an NVIDIA driver on the host and the NVIDIA Container Toolkit; run with
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md README.ru.md LICENSE NOTICE.md ./
COPY flysim ./flysim
RUN pip install --no-cache-dir -e ".[cuda]"
COPY scripts ./scripts
COPY docker ./docker
COPY ASSUMPTIONS.md KNOWN_ISSUES.md PLAN.md ./
COPY data/raw/odor ./data/raw/odor
RUN sed -i 's/\r$//' scripts/*.sh docker/*.sh && chmod +x scripts/*.sh docker/*.sh

ENV NUMBA_CACHE_DIR=/app/data/.numba-cache \
    PYTHONUNBUFFERED=1 \
    FLYSIM_BACKEND=cuda
EXPOSE 8800
CMD ["sh", "docker/entrypoint.sh"]
